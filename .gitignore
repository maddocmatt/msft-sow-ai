# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
dist/
build/

# Env / secrets
.env
.env.*
!.env.example
local.settings.json
*.pem
*.pfx

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Azure / deploy
.azure/
*.tfstate
*.tfstate.*
.terraform/

# Generated outputs (we keep source corpus + templates, not run output)
runs/
deliverables/
output/
*.docx~
~$*

# Logs
*.log

# --- Sensitive content (LOCAL ONLY — never commit) ---
# Templates and corpus may contain customer-identifying material or MS-internal
# content not approved for redistribution. We keep them on disk for the agents
# to use, but the only thing that is allowed in git are README.md files and
# de-identified mined profiles (templates/_profiles/*.json — structural only).
templates/**/*.docx
templates/**/*.docm
templates/**/*.xlsx
templates/**/*.xlsm
templates/**/*.pptx
templates/**/*.pptm
templates/**/*.pdf
templates/**/*.mpp

corpus/**/*
!corpus/**/README.md
!corpus/**/.gitkeep

sqa/rejection_samples/**/*
!sqa/rejection_samples/**/README.md
!sqa/rejection_samples/**/.gitkeep

# Private/draft notes that shouldn't be committed
*.private.md
*.private.*

infra/bicep/**/*.json

# Function app vendored at deploy time
function_app/shared/
function_app/sqa/
function_app/rubrics/
function_app/local.settings.json
function_app/.python_packages/
